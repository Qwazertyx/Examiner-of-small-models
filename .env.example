# Set these in Vercel (Project > Settings > Environment Variables), never in the repo.
# Public https address of the tunnel in front of phone/relay.py (printed by phone/start.sh)
PHONE_URL=
# Same secret as on the phone (printed by phone/start.sh)
PHONE_TOKEN=
# Optional: 1 plays without a phone, with the scenario's own lines. Leave unset to wait for the phone.
SCRIPTED=
